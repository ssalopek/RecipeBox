<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for Android 11 and older. Back up only the recipe database and
     the saved images. Note that Auto Backup stops at roughly 25 MB per app. -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="file" path="recipe_images/" />
</full-backup-content>
